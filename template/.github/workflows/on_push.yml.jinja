{% if publishes_packages %}{% raw %}name: on_push

# Generated from plexus-ms/template-repo-turbo: edit the template, never this file.
# A package repo's trunk mount, check then publish (§ 5 PLX-Delivery).

on:
  push:
    branches: [main]

permissions:
  contents: write
  pull-requests: write
  id-token: write

jobs:
  check:
    uses: plexus-ms/tooling/.github/workflows/_check.yml@0.123.0
    with:
      strategy: ${{ vars.CI_STRATEGY || '{% endraw %}{{ ci_strategy }}{% raw %}' }}
      tasks: verify

  publish:
    needs: check
    uses: plexus-ms/tooling/.github/workflows/_publish-package.yml@0.123.0
    with:
      strategy: ${{ vars.CI_STRATEGY || '{% endraw %}{{ ci_strategy }}{% raw %}' }}
{% endraw %}{% else %}{% raw %}name: on_push

# Generated from plexus-ms/template-repo-turbo: edit the template, never this file.
# An app repo's environment-branch mount, check, verify, release (§§ 2 and 3 PLX-Delivery).

on:
  # No paths filter: a branch created at a known commit pushes no files and would start nothing.
  push:
    branches: [main, develop]
  workflow_dispatch:

permissions:
  contents: read
  packages: write
  actions: read

jobs:
  check:
    concurrency:
      group: on_push-verify-${{ github.ref }}
      cancel-in-progress: true
    uses: plexus-ms/tooling/.github/workflows/_check.yml@0.123.0
    with:
      strategy: ${{ vars.CI_STRATEGY || '{% endraw %}{{ ci_strategy }}{% raw %}' }}
      turbo-cache: {% endraw %}{{ 'true' if ci_registry == 'own' else 'false' }}{% raw %}
    secrets:
      op-service-account-token: ${{ secrets.OP_SERVICE_ACCOUNT_TOKEN }}

  verify:
    needs: check
    concurrency:
      group: on_push-verify-${{ github.ref }}
      cancel-in-progress: true
    uses: plexus-ms/tooling/.github/workflows/_verify.yml@0.123.0
    with:
      strategy: ${{ vars.CI_STRATEGY || '{% endraw %}{{ ci_strategy }}{% raw %}' }}
      registry: {% endraw %}{{ ci_registry }}{% raw %}
      deploy: true
      alerts-email: '{% endraw %}{{ alerts_email }}{% raw %}'
    secrets:
      op-service-account-token: ${{ secrets.OP_SERVICE_ACCOUNT_TOKEN }}

  release:
    needs: verify
    uses: plexus-ms/tooling/.github/workflows/_release.yml@0.123.0
    with:
      strategy: ${{ vars.CI_STRATEGY || '{% endraw %}{{ ci_strategy }}{% raw %}' }}
      registry: {% endraw %}{{ ci_registry }}{% raw %}
      overlay: {% endraw %}{{ ci_overlay }}{% raw %}
      apps: ${{ needs.verify.outputs.apps }}
      deploys: ${{ needs.verify.outputs.deploys }}
      environment: ${{ needs.verify.outputs.environment }}
    secrets:
      op-service-account-token: ${{ secrets.OP_SERVICE_ACCOUNT_TOKEN }}
{% endraw %}{% endif %}