{% raw %}name: update

# Mounts the update verb (§ 3 PLX-Updates): `plx update` takes a patch at once, a
# minor once the oldest version not taken is update_max_age days old, a major only
# when asked. Managed by copier: edit the template (plexus-ms/template-repo-turbo).
#
# The push and the pull request need an identity of the tenant's own: a GitHub
# App installed on this repo with contents and pull requests write, its ID in
# the repo or organisation variable PLX_APP_ID and its private key in the
# secret PLX_APP_PRIVATE_KEY (the same app the changeset job of a package repo
# pushes with). Until the variable is set the job is skipped, not failed.

on:
  schedule:
    - cron: '23 6 * * *'
  workflow_dispatch:
    inputs:
      version:
        description: "The version to take (default: the newest)"
        required: false
        default: ''

permissions:
  contents: write
  pull-requests: write

# Where the jobs run: see on_pr.yml.
jobs:
  update:
    if: ${{ vars.PLX_APP_ID != '' }}
    uses: plexus-ms/tooling/.github/workflows/_update.yml@0.122.1
    with:
      version: ${{ inputs.version || '' }}
      now: ${{ github.event_name == 'workflow_dispatch' }}
      app_id: ${{ vars.PLX_APP_ID }}
      strategy: ${{ vars.CI_STRATEGY || '{% endraw %}{{ ci_strategy }}{% raw %}' }}
    secrets:
      app_private_key: ${{ secrets.PLX_APP_PRIVATE_KEY }}
{% endraw %}
